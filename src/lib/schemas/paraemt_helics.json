{
  "title": "ParaEMT Configuration",
  "description": "JSON Schema for the ParaEMT runtime configuration. This schema describes parameter names, data types, defaults, and basic validation rules. The runtime parameter values remain stored in Config.json.",
  "type": "object",
  "properties": {
    "name": {
      "title": "Name",
      "description": "Component instance name.",
      "type": "string"
    },
    "powerflow": {
      "$ref": "#/$defs/PowerFlowParameters"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationParameters"
    },
    "forced_oscillation": {
      "$ref": "#/$defs/ForcedOscillationParameters"
    },
    "gen_trip": {
      "$ref": "#/$defs/GeneratorTripParameters"
    },
    "bus_fault": {
      "$ref": "#/$defs/BusFaultParameters"
    },
    "state_perturbation": {
      "$ref": "#/$defs/StatePerturbationParameters"
    },
    "step_change": {
      "$ref": "#/$defs/StepChangeParameters"
    }
  },
  "required": [
    "name",
    "powerflow",
    "simulation",
    "forced_oscillation",
    "gen_trip",
    "bus_fault",
    "state_perturbation",
    "step_change"
  ],
  "additionalProperties": false,
  "$defs": {
    "PowerFlowParameters": {
      "title": "Power Flow Parameters",
      "description": "Parameters used by the power-flow initialization.",
      "type": "object",
      "properties": {
        "systemN": {
          "title": "System Identifier",
          "description": "Select the power-system case.",
          "type": "number",
          "default": 7.3,
          "enum": [1, 2, 3, 4.8, 5, 6, 7.3],
          "oneOf": [
            {
              "const": 1,
              "title": "Two-generator system"
            },
            {
              "const": 2,
              "title": "3-bus IBR benchmark"
            },
            {
              "const": 3,
              "title": "IEEE 9-bus system"
            },
            {
              "const": 4.8,
              "title": "Kundur two-area system"
            },
            {
              "const": 5,
              "title": "IEEE 39-bus system"
            },
            {
              "const": 6,
              "title": "WECC 179-bus system"
            },
            {
              "const": 7.3,
              "title": "WECC 240-bus system"
            }
          ],
          "x-ui-category": "User-facing"
        }
      },
      "required": ["systemN"],
      "additionalProperties": false,
      "default": {
        "systemN": 7.3
      }
    },
    "SimulationParameters": {
      "title": "Simulation Parameters",
      "description": "General ParaEMT simulation, output, playback, and HELICS settings.",
      "type": "object",
      "properties": {
        "systemN": {
          "title": "System Identifier",
          "description": "Select the power-system case.",
          "type": "number",
          "default": 7.3,
          "enum": [1, 2, 3, 4.8, 5, 6, 7.3],
          "oneOf": [
            {
              "const": 1,
              "title": "Two-generator system"
            },
            {
              "const": 2,
              "title": "3-bus IBR benchmark"
            },
            {
              "const": 3,
              "title": "IEEE 9-bus system"
            },
            {
              "const": 4.8,
              "title": "Kundur two-area system"
            },
            {
              "const": 5,
              "title": "IEEE 39-bus system"
            },
            {
              "const": 6,
              "title": "WECC 179-bus system"
            },
            {
              "const": 7.3,
              "title": "WECC 240-bus system"
            }
          ],
          "x-ui-category": "User-facing"
        },
        "ts": {
          "title": "Simulation Time Step",
          "description": "EMT simulation time step, in seconds.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5e-5,
          "x-ui-category": "User-facing"
        },
        "t_end": {
          "title": "Simulation End Time",
          "description": "Total EMT simulation duration, in seconds.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5.0,
          "x-ui-category": "User-facing"
        },
        "DSrate": {
          "title": "Downsampling Rate",
          "description": "Desampling rate for output channels, the number of simulation steps between sampled outputs; for ts=0.00005 and DSrate=20, output sample rate is 0.001 s (1 kHz)",
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "x-ui-category": "User-facing"
        },
        "netMod": {
          "title": "Network Solution Mode",
          "description": "Network equation solution method or implementation mode.",
          "type": "string",
          "minLength": 1,
          "default": "lu",
          "examples": ["lu"],
          "x-ui-category": "Internal / Debugging"
        },
        "dump_all": {
          "title": "Dump All Results",
          "description": "Whether to dump all available simulation results.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "Internal / Debugging"
        },
        "show_progress": {
          "title": "Show Progress",
          "description": "Display simulation progress.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "save_results_csv": {
          "title": "Save Results as CSV",
          "description": "Save simulation results as CSV files.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "N_row": {
          "title": "Partition Rows",
          "description": "Number of row partitions used by the simulation layout or decomposition.",
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "x-ui-category": "Internal / Debugging"
        },
        "N_col": {
          "title": "Partition Columns",
          "description": "Number of column partitions used by the simulation layout or decomposition.",
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "x-ui-category": "Internal / Debugging"
        },
        "SimMod": {
          "title": "Simulation Mode",
          "description": "Select the simulation initialization mode.",
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "enum": [0, 1],
          "oneOf": [
            {
              "const": 0,
              "title": "Standard initialization"
            },
            {
              "const": 1,
              "title": "Initialize from snapshot"
            }
          ],
          "maximum": 1,
          "x-ui-category": "User-facing"
        },
        "save_snapshot": {
          "title": "Save Snapshot",
          "description": "Save a snapshot at the end of the simulation.",
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "oneOf": [
            {
              "const": 0,
              "title": "Do not save snapshot"
            },
            {
              "const": 1,
              "title": "Save snapshot"
            }
          ],
          "x-ui-category": "User-facing"
        },
        "save_snapshot_mode": {
          "title": "Snapshot Mode",
          "description": "Select snapshot/result output.",
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "enum": [0, 1, 2],
          "oneOf": [
            {
              "const": 0,
              "title": "One-point snapshot"
            },
            {
              "const": 1,
              "title": "Whole simulation result"
            },
            {
              "const": 2,
              "title": "Both"
            }
          ],
          "maximum": 2,
          "x-ui-category": "User-facing"
        },
        "t_release_f": {
          "title": "Release Time",
          "description": "Time when PLL frequency is released from the fixed synchronous-frequency value, in seconds.",
          "type": "number",
          "minimum": 0,
          "default": 0.0,
          "x-ui-category": "User-facing"
        },
        "loadmodel_option": {
          "title": "Load Model Option",
          "description": "Select the load model.",
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "enum": [1, 2],
          "oneOf": [
            {
              "const": 1,
              "title": "Constant RLC"
            },
            {
              "const": 2,
              "title": "Constant impedance (Z)"
            }
          ],
          "maximum": 2,
          "x-ui-category": "User-facing"
        },
        "EMT_N": {
          "title": "EMT Model Count or Index",
          "description": "Integer parameter identifying the EMT model count, partition, or selected EMT subsystem.",
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "x-ui-category": "Internal / Debugging"
        },
        "kts": {
          "title": "Time-Step Index",
          "description": "Integer time-step-related index used internally by the simulation.",
          "type": "integer",
          "minimum": 0,
          "default": 333,
          "x-ui-category": "Internal / Debugging"
        },
        "stepk": {
          "title": "Simulation Step Index",
          "description": "Integer simulation-step index used internally by the simulation.",
          "type": "integer",
          "minimum": 0,
          "default": 332,
          "x-ui-category": "Internal / Debugging"
        },
        "record4cosim": {
          "title": "Record for Co-simulation",
          "description": "Whether to record data intended for co-simulation.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "Internal / Debugging"
        },
        "playback_voltphasor": {
          "title": "Playback Voltage Phasor",
          "description": "Whether voltage-phasor playback is enabled.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "Internal / Debugging"
        },
        "playback_enable": {
          "title": "Enable Playback",
          "description": "Whether the playback workflow is enabled.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "Internal / Debugging"
        },
        "flag_changeKp": {
          "title": "Enable Kp Change",
          "description": "Whether the controller proportional gain is changed during the simulation.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "Internal / Debugging"
        },
        "Kp_new": {
          "title": "New Kp Value",
          "description": "Replacement proportional gain used when flag_changeKp is enabled.",
          "type": "number",
          "default": 7,
          "x-ui-category": "Internal / Debugging"
        },
        "helics_live_enable": {
          "title": "Enable HELICS Live Publishing",
          "description": "Enable live publishing of simulation data through HELICS.",
          "type": "boolean",
          "default": true,
          "x-ui-category": "User-facing"
        },
        "helics_period": {
          "title": "HELICS Publishing Period",
          "description": "Time interval between HELICS data publications, in seconds. The runtime rounds helics_period / ts to a whole number of EMT steps.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.001,
          "x-ui-category": "User-facing"
        }
      },
      "required": [
        "systemN",
        "ts",
        "t_end",
        "DSrate",
        "netMod",
        "dump_all",
        "show_progress",
        "save_results_csv",
        "N_row",
        "N_col",
        "SimMod",
        "save_snapshot",
        "save_snapshot_mode",
        "t_release_f",
        "loadmodel_option",
        "EMT_N",
        "kts",
        "stepk",
        "record4cosim",
        "playback_voltphasor",
        "playback_enable",
        "flag_changeKp",
        "Kp_new",
        "helics_live_enable",
        "helics_period"
      ],
      "additionalProperties": false,
      "default": {
        "systemN": 7.3,
        "ts": 5e-5,
        "t_end": 5.0,
        "DSrate": 20,
        "netMod": "lu",
        "dump_all": false,
        "show_progress": false,
        "save_results_csv": false,
        "N_row": 1,
        "N_col": 1,
        "SimMod": 1,
        "save_snapshot": 0,
        "save_snapshot_mode": 0,
        "t_release_f": 0.0,
        "loadmodel_option": 1,
        "EMT_N": 1,
        "kts": 333,
        "stepk": 332,
        "record4cosim": false,
        "playback_voltphasor": false,
        "playback_enable": false,
        "flag_changeKp": false,
        "Kp_new": 7,
        "helics_live_enable": true,
        "helics_period": 0.001
      }
    },
    "ForcedOscillationParameters": {
      "title": "Forced Oscillation Parameters",
      "description": "Parameters for injecting a forced oscillation into a selected generator controller.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Forced Oscillation",
          "description": "Enable sinusoidal forced-oscillation injection.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "start_time": {
          "title": "Start Time",
          "description": "Time when forced-oscillation injection starts, in seconds.",
          "type": "number",
          "minimum": 0,
          "default": 1000.0,
          "x-ui-category": "User-facing"
        },
        "target_gen": {
          "title": "Target Generator",
          "description": "Generator receiving the injected signal, selected by generator index, not bus number.",
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "x-ui-category": "User-facing"
        },
        "flag_exc_gov_fo": {
          "title": "Exciter or Governor Selection",
          "description": "Select the controller reference for forced-oscillation injection.",
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "enum": [0, 1],
          "oneOf": [
            {
              "const": 0,
              "title": "Exciter (Vref)"
            },
            {
              "const": 1,
              "title": "Governor (Pref)"
            }
          ],
          "maximum": 1,
          "x-ui-category": "User-facing"
        },
        "magnitude": {
          "title": "Oscillation Magnitude",
          "description": "Amplitude of the injected oscillation.",
          "type": "number",
          "default": 2.0,
          "x-ui-category": "User-facing"
        },
        "frequency_hz": {
          "title": "Oscillation Frequency",
          "description": "Frequency of the injected oscillation, in Hz.",
          "type": "number",
          "minimum": 0,
          "default": 5.0,
          "exclusiveMinimum": 0,
          "x-ui-category": "User-facing"
        },
        "lock_ini": {
          "title": "Lock Initial Value",
          "description": "Integer flag controlling whether an initial value is locked.",
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "x-ui-category": "Internal / Debugging"
        },
        "lock_value": {
          "title": "Locked Value",
          "description": "Value used when lock_ini is enabled.",
          "type": "number",
          "default": 0,
          "x-ui-category": "Internal / Debugging"
        }
      },
      "required": [
        "enabled",
        "start_time",
        "target_gen",
        "flag_exc_gov_fo",
        "magnitude",
        "frequency_hz",
        "lock_ini",
        "lock_value"
      ],
      "additionalProperties": false,
      "default": {
        "enabled": false,
        "start_time": 1000.0,
        "target_gen": 1,
        "flag_exc_gov_fo": 1,
        "magnitude": 2.0,
        "frequency_hz": 5.0,
        "lock_ini": 0,
        "lock_value": 0
      }
    },
    "GeneratorTripParameters": {
      "title": "Generator Trip Parameters",
      "description": "Parameters for a generator-trip disturbance.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Generator Trip",
          "description": "Enable generator tripping.",
          "type": "boolean",
          "default": true,
          "x-ui-category": "User-facing"
        },
        "time": {
          "title": "Trip Time",
          "description": "Time when the selected generator trips, in seconds.",
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "x-ui-category": "User-facing"
        },
        "target_gen": {
          "title": "Target Generator",
          "description": "Generator to trip, selected by generator index, not bus number.",
          "type": "integer",
          "minimum": 1,
          "default": 33,
          "x-ui-category": "User-facing"
        },
        "flag_reinit": {
          "title": "Reinitialization Flag",
          "description": "Integer flag controlling model reinitialization after the trip.",
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "x-ui-category": "Internal / Debugging"
        }
      },
      "required": ["enabled", "time", "target_gen", "flag_reinit"],
      "additionalProperties": false,
      "default": {
        "enabled": true,
        "time": 1.0,
        "target_gen": 33,
        "flag_reinit": 0
      }
    },
    "BusFaultParameters": {
      "title": "Bus Fault Parameters",
      "description": "Parameters for applying a bus fault and optionally tripping a line.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Bus Fault",
          "description": "Enable a bus fault.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "time": {
          "title": "Fault Start Time",
          "description": "Time when the bus fault starts, in seconds.",
          "type": "number",
          "minimum": 0,
          "default": 100.0,
          "x-ui-category": "User-facing"
        },
        "fault_bus_idx": {
          "title": "Faulted Bus Index",
          "description": "Bus fault location, specified by bus-array index, not physical bus number.",
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "x-ui-category": "User-facing"
        },
        "duration": {
          "title": "Fault Duration",
          "description": "Duration of the bus fault, in seconds. [range: 0 < duration ≤ t_end - time; default: 5/60 s]",
          "type": "number",
          "minimum": 0,
          "default": 0.06666666666666667,
          "exclusiveMinimum": 0,
          "x-ui-category": "User-facing"
        },
        "fault_type": {
          "title": "Fault Type",
          "description": "Electrical fault type code defined by the fault routine.",
          "type": "integer",
          "minimum": 0,
          "default": 7,
          "x-ui-category": "User-facing"
        },
        "fault_r": {
          "title": "Fault Resistance Parameters",
          "description": "Six fault-resistance parameters used by the fault model. [range: exactly six nonnegative numbers; default: six values of 0.00001]",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 6,
          "default": [1e-5, 1e-5, 1e-5, 1e-5, 1e-5, 1e-5],
          "x-ui-category": "User-facing"
        },
        "trip_line": {
          "title": "Trip Line",
          "description": "Whether to trip a line during the fault sequence.",
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "oneOf": [
            {
              "const": 0,
              "title": "Do not trip line"
            },
            {
              "const": 1,
              "title": "Trip selected line"
            }
          ],
          "x-ui-category": "User-facing"
        },
        "fault_line_idx": {
          "title": "Faulted Line Index",
          "description": "Line-array index associated with the fault or line trip, not a bus number. [range: case-dependent line-array index; default: 0]",
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "x-ui-category": "User-facing"
        }
      },
      "required": [
        "enabled",
        "time",
        "fault_bus_idx",
        "duration",
        "fault_type",
        "fault_r",
        "trip_line",
        "fault_line_idx"
      ],
      "additionalProperties": false,
      "default": {
        "enabled": false,
        "time": 100.0,
        "fault_bus_idx": 0,
        "duration": 0.06666666666666667,
        "fault_type": 7,
        "fault_r": [1e-5, 1e-5, 1e-5, 1e-5, 1e-5, 1e-5],
        "trip_line": 0,
        "fault_line_idx": 0
      }
    },
    "StatePerturbationParameters": {
      "title": "State Perturbation Parameters",
      "description": "Parameters for perturbing a selected state of a selected device.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable State Perturbation",
          "description": "Enable perturbation of a device internal state.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "time": {
          "title": "Perturbation Time",
          "description": "Time when the state perturbation is applied, in seconds. [range: 0 ≤ time < t_end]",
          "type": "number",
          "minimum": 0,
          "default": 1000.0,
          "x-ui-category": "User-facing"
        },
        "dx": {
          "title": "State Perturbation Magnitude",
          "description": "Amount added to the selected internal state variable.",
          "type": "number",
          "default": 0.1,
          "x-ui-category": "User-facing"
        },
        "type": {
          "title": "Device Type",
          "description": "Select the device model whose state is perturbed.",
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "enum": [0, 1, 2],
          "oneOf": [
            {
              "const": 0,
              "title": "Synchronous generator (SG)"
            },
            {
              "const": 1,
              "title": "WECC IBR"
            },
            {
              "const": 2,
              "title": "EPRI IBR"
            }
          ],
          "x-ui-category": "User-facing"
        },
        "device_index": {
          "title": "Device Index",
          "description": "Device selected by index, not bus number. [range: 1..N_SG for SG or 1..N_IBR for the selected IBR model, case-dependent; default: 4]",
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "x-ui-category": "User-facing"
        },
        "state_index": {
          "title": "State Index",
          "description": "Internal state selected by 1-based index. [range: SG 1..18; WECC IBR 1..41; EPRI IBR 1..13; default: 1]",
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "maximum": 41,
          "x-ui-category": "User-facing"
        }
      },
      "required": [
        "enabled",
        "time",
        "dx",
        "type",
        "device_index",
        "state_index"
      ],
      "additionalProperties": false,
      "default": {
        "enabled": false,
        "time": 1000.0,
        "dx": 0.1,
        "type": 1,
        "device_index": 4,
        "state_index": 1
      }
    },
    "StepChangeParameters": {
      "title": "Step Change Parameters",
      "description": "Parameters for applying a step change through a selected generator controller.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Step Change",
          "description": "Enable a controller reference step change.",
          "type": "boolean",
          "default": false,
          "x-ui-category": "User-facing"
        },
        "time": {
          "title": "Step Time",
          "description": "Time when the controller step is applied, in seconds. [range: 0 ≤ time < t_end;]",
          "type": "number",
          "minimum": 0,
          "default": 0.0,
          "x-ui-category": "User-facing"
        },
        "target_gen": {
          "title": "Target Generator",
          "description": "Generator receiving the controller step, selected by generator index, not bus number. [range: 1..N_SG, case-dependent]",
          "type": "integer",
          "minimum": 1,
          "default": 44,
          "x-ui-category": "User-facing"
        },
        "flag_exc_gov": {
          "title": "Exciter or Governor Selection",
          "description": "Select the generator controller receiving the step.",
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "enum": [0, 1],
          "oneOf": [
            {
              "const": 0,
              "title": "Exciter"
            },
            {
              "const": 1,
              "title": "Governor"
            }
          ],
          "x-ui-category": "User-facing"
        },
        "magnitude": {
          "title": "Step Magnitude",
          "description": "Size of the controller step change.",
          "type": "number",
          "default": 0.3,
          "x-ui-category": "User-facing"
        }
      },
      "required": [
        "enabled",
        "time",
        "target_gen",
        "flag_exc_gov",
        "magnitude"
      ],
      "additionalProperties": false,
      "default": {
        "enabled": false,
